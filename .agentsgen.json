{
  "version": 1,
  "mode": "safe",
  "on_missing_markers": "write_generated",
  "generated_suffix": ".generated",
  "markers": {
    "start": "<!-- AGENTSGEN:START section={section} -->",
    "end": "<!-- AGENTSGEN:END section={section} -->"
  },
  "sections": [
    "guardrails",
    "workflow",
    "style",
    "verification",
    "stack",
    "repo_context"
  ],
  "presets": {},
  "defaults": {},
  "project": {
    "primary_stack": "documentation",
    "name": "DecisionMap",
    "repo_root": "."
  },
  "paths": {
    "docs": [
      "README.md",
      "USAGE.md",
      "protocol.md",
      "skills/decision-map/SKILL.md"
    ],
    "ci": ".github/workflows/validate-examples.yml"
  },
  "commands": {
    "check": "python3 scripts/check_repo.py",
    "validate_examples": "python3 scripts/validate_examples.py"
  },
  "evidence": {
    "python": [],
    "node": [],
    "make": [],
    "ci": []
  },
  "pack": {
    "enabled": false,
    "llms_format": "txt",
    "output_dir": "docs/ai",
    "files": []
  }
}
